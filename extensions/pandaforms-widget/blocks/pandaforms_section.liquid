{% comment %}
  PandaForms section app block
  This block appears in Online Store > Theme Editor > Add section > Apps.
{% endcomment %}

{%- assign spacing_px = '24px' -%}
{%- if block.settings.card_spacing == 'none' -%}
  {%- assign spacing_px = '0px' -%}
{%- elsif block.settings.card_spacing == 'small' -%}
  {%- assign spacing_px = '12px' -%}
{%- elsif block.settings.card_spacing == 'large' -%}
  {%- assign spacing_px = '48px' -%}
{%- elsif block.settings.card_spacing == 'huge' -%}
  {%- assign spacing_px = '80px' -%}
{%- endif -%}

<section class="pandaforms-section" id="pandaforms-{{ block.id }}" style="padding-top: {{ spacing_px }}; padding-bottom: {{ spacing_px }}; width: 100%;">
  <div class="pandaforms-card" style="max-width: {{ block.settings.form_width }}px; margin: 0 auto; padding: 28px; border-radius: {{ block.settings.border_radius }}px; background: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }}; border: 1px solid {{ block.settings.border_color }};">
    <div class="pandaforms-loading" style="text-align:center; padding: 16px;">Loading PandaForms...</div>
    <div class="pandaforms-content" style="display:none;">
      <h2 class="pandaforms-title" style="margin: 0 0 8px; text-align:center; color: {{ block.settings.text_color }};"></h2>
      <p class="pandaforms-desc" style="margin: 0 0 22px; text-align:center; color: {{ block.settings.text_color }}; opacity:.78;"></p>
      <form class="pandaforms-form" style="display:flex; flex-direction:column; gap:16px;">
        <div class="pandaforms-fields" style="display:flex; flex-wrap:wrap; gap:16px;"></div>
        <button type="submit" class="pandaforms-submit" style="width:100%; padding:13px 16px; border:0; border-radius:{{ block.settings.button_radius }}px; background:{{ block.settings.button_bg_color }}; color:{{ block.settings.button_text_color }}; font-weight:700; cursor:pointer;">
          {{ block.settings.button_text }}
        </button>
      </form>
    </div>
    <div class="pandaforms-success" style="display:none; text-align:center; padding:20px; color: {{ block.settings.success_color }};">
      <h3 style="margin:0 0 8px;">Success</h3>
      <p class="pandaforms-success-msg" style="margin:0;"></p>
    </div>
  </div>
</section>

<script>
(function() {
  var blockId = {{ block.id | json }};
  var formId = {{ block.settings.form_id | json }};
  var apiUrl = {{ block.settings.api_url | json }}.replace(/\/$/, '');
  var root = document.getElementById('pandaforms-' + blockId);
  if (!root) return;
  var loading = root.querySelector('.pandaforms-loading');
  var content = root.querySelector('.pandaforms-content');
  var fieldsWrap = root.querySelector('.pandaforms-fields');
  var formEl = root.querySelector('.pandaforms-form');
  var success = root.querySelector('.pandaforms-success');
  var submitBtn = root.querySelector('.pandaforms-submit');
  var redirectUrl = '';
  var themeStyles = {};

  function showError(message) {
    loading.innerHTML = '<p style="color:#b42318; margin:0;">' + message + '</p>';
  }

  if (!formId) {
    showError('PandaForms: Please add the Form ID from the PandaForms app.');
    return;
  }

  function toStyleString(obj) {
    if (!obj) return '';
    return Object.keys(obj).map(function(key) {
      var kebab = key.replace(/([A-Z])/g, '-$1').toLowerCase();
      return kebab + ':' + obj[key];
    }).join(';') + ';';
  }

  function getThemeStyles(selectedTheme) {
    switch (selectedTheme) {
      case 'dark':
        return {
          wrapper: { backgroundColor: '#0f172a', color: '#f8fafc', padding: '32px', borderRadius: '12px', border: '1px solid #334155' },
          title: { color: '#f8fafc' },
          desc: { color: '#94a3b8' },
          label: { color: '#cbd5e1' },
          input: { backgroundColor: '#1e293b', border: '1px solid #475569', color: '#f8fafc', borderRadius: '6px' },
          button: { backgroundColor: '#10b981', color: '#ffffff', border: 'none', borderRadius: '6px' }
        };
      case 'glassmorphism':
        return {
          wrapper: { backgroundColor: '#ffffff', color: '#1e293b', padding: '32px', borderRadius: '12px' },
          title: { color: '#0f172a' },
          desc: { color: '#64748b' },
          label: { color: '#334155' },
          input: { backgroundColor: '#ffffff', border: '1px solid #cbd5e1', color: '#1e293b', borderRadius: '6px' },
          button: { backgroundColor: '#008060', color: '#ffffff', border: 'none', borderRadius: '6px' }
        };
      case 'playful':
        return {
          wrapper: { backgroundColor: '#ffffff', color: '#1e293b', padding: '32px', borderRadius: '8px' },
          title: { color: '#0f172a' },
          desc: { color: '#64748b' },
          label: { color: '#334155' },
          input: { backgroundColor: '#ffffff', border: '1px solid #cbd5e1', color: '#1e293b', borderRadius: '4px' },
          button: { backgroundColor: '#18181b', color: '#ffffff', border: 'none', borderRadius: '4px' }
        };
      case 'classic':
        return {
          wrapper: { backgroundColor: '#f6f6f7', color: '#202223', padding: '24px', borderRadius: '4px', border: '1px solid #e1e3e5' },
          title: { color: '#202223' },
          desc: { color: '#6d7175' },
          label: { color: '#202223' },
          input: { backgroundColor: '#ffffff', border: '1px solid #8c9196', color: '#202223', borderRadius: '4px' },
          button: { backgroundColor: '#008060', color: '#ffffff', border: 'none', borderRadius: '4px' }
        };
      case 'minimal':
      default:
        return {
          wrapper: { backgroundColor: '#ffffff', color: '#1e293b', padding: '24px', borderRadius: '8px', border: '1px solid #e2e8f0' },
          title: { color: '#0f172a' },
          desc: { color: '#64748b' },
          label: { color: '#334155' },
          input: { backgroundColor: '#ffffff', border: 'none', borderBottom: '2px solid #cbd5e1', color: '#1e293b', borderRadius: '0px' },
          button: { backgroundColor: '#0f172a', color: '#ffffff', border: 'none', borderRadius: '8px' }
        };
    }
  }

  function loadForm() {
    var timestamp = Date.now();
    var proxyUrl = '/apps/pandaforms/form-config?id=' + encodeURIComponent(formId) + '&t=' + timestamp;
    var directUrl = apiUrl + '/api/form-config?id=' + encodeURIComponent(formId) + '&t=' + timestamp;
    
    fetch(proxyUrl).then(function(res) {
      if (!res.ok) throw new Error('proxy failed');
      return res.json();
    }).catch(function() {
      return fetch(directUrl).then(function(res) {
        if (!res.ok) throw new Error('direct failed');
        return res.json();
      });
    }).then(function(data) {
      var form = data.form || data;
      
      var cardEl = root.querySelector('.pandaforms-card');
      var titleEl = root.querySelector('.pandaforms-title');
      var descEl = root.querySelector('.pandaforms-desc');
      
      if (titleEl) titleEl.innerText = form.title || '';
      if (descEl) descEl.innerText = form.description || '';
      root.querySelector('.pandaforms-success-msg').innerText = form.successMessage || 'Thank you!';
      redirectUrl = form.redirectUrl || '';

      // Parse customStyles if configured
      var customStyles = null;
      if (form.customStyles) {
        try {
          customStyles = JSON.parse(form.customStyles);
        } catch(e) {
          console.error("Failed to parse customStyles", e);
        }
      }

      var themeStyles = getThemeStyles(form.theme || 'minimal');

      // Ready-made Color Scheme Presets
      var presets = {
        shopify_default: {
          bg_color: '#ffffff',
          text_color: '#1e293b',
          border_color: '#cbd5e1',
          input_bg_color: '#ffffff',
          input_border_color: '#cbd5e1',
          input_text_color: '#1e293b',
          btn_bg_color: '#008060',
          btn_text_color: '#ffffff',
          btn_hover_bg_color: '#005e46',
          success_text_color: '#10b981'
        },
        minimal: {
          bg_color: '#ffffff',
          text_color: '#27272a',
          border_color: '#e2e8f0',
          input_bg_color: '#ffffff',
          input_border_color: '#e2e8f0',
          input_text_color: '#27272a',
          btn_bg_color: '#18181b',
          btn_text_color: '#ffffff',
          btn_hover_bg_color: '#3f3f46',
          success_text_color: '#16a34a'
        },
        modern: {
          bg_color: '#ffffff',
          text_color: '#09090b',
          border_color: '#e2e8f0',
          input_bg_color: '#f4f4f5',
          input_border_color: '#e2e8f0',
          input_text_color: '#09090b',
          btn_bg_color: '#0f172a',
          btn_text_color: '#ffffff',
          btn_hover_bg_color: '#1e293b',
          success_text_color: '#10b981'
        },
        premium: {
          bg_color: '#ffffff',
          text_color: '#1c1917',
          border_color: '#cbd5e1',
          input_bg_color: '#fafaf9',
          input_border_color: '#cbd5e1',
          input_text_color: '#1c1917',
          btn_bg_color: '#1c1917',
          btn_text_color: '#ffffff',
          btn_hover_bg_color: '#292524',
          success_text_color: '#10b981'
        },
        dark: {
          bg_color: '#09090b',
          text_color: '#f4f4f5',
          border_color: '#27272a',
          input_bg_color: '#18181b',
          input_border_color: '#27272a',
          input_text_color: '#f4f4f5',
          btn_bg_color: '#ffffff',
          btn_text_color: '#09090b',
          btn_hover_bg_color: '#e4e4e7',
          success_text_color: '#10b981'
        }
      };

      var presetStyle = "{{ block.settings.preset_style | default: 'app_theme' }}";
      var preset = presets[presetStyle] || {};

      var isMinimalTheme = (form.theme || 'minimal') === 'minimal';
      var validPresets = ['shopify_default', 'minimal', 'modern', 'premium', 'dark', 'custom'];
      var isAppTheme = presetStyle !== 'custom';

      // Setup a unified design system config mapping to apply styles
      var resolvedStyles = {};

      if (customStyles) {
        resolvedStyles.bgColor = customStyles.colors.bgColor || '#ffffff';
        resolvedStyles.textColor = customStyles.colors.textColor || '#1e293b';
        resolvedStyles.fieldBgColor = customStyles.colors.fieldBgColor || '#ffffff';
        resolvedStyles.fieldBorderColor = customStyles.colors.fieldBorderColor || '#cbd5e1';
        resolvedStyles.labelColor = customStyles.colors.labelColor || '#334155';
        resolvedStyles.btnBgColor = customStyles.colors.btnBgColor || '#008060';
        resolvedStyles.btnTextColor = customStyles.colors.btnTextColor || '#ffffff';
        resolvedStyles.btnHoverBgColor = customStyles.colors.btnHoverColor || '';
        resolvedStyles.successColor = customStyles.colors.successColor || '#10b981';
        resolvedStyles.successBgColor = customStyles.colors.successBgColor || '#f0fdf4';
        resolvedStyles.errorColor = customStyles.colors.errorColor || '#ef4444';
        
        resolvedStyles.formWidth = parseInt(customStyles.layout.formWidth) || 650;
        resolvedStyles.borderRadius = parseInt(customStyles.layout.borderRadius) || 4;
        resolvedStyles.inputBorderRadius = parseInt(customStyles.layout.borderRadius) || 4;
        resolvedStyles.btnBorderRadius = parseInt(customStyles.layout.borderRadius) || 4;
        resolvedStyles.shadow = customStyles.layout.shadow || 'subtle';
        
        var inputSizeVal = customStyles.layout.inputSize || 'medium';
        resolvedStyles.inputPadding = inputSizeVal === 'small' ? '8px 12px' :
                                     inputSizeVal === 'large' ? '16px 20px' :
                                     '12px 16px';
                                     
        var btnSizeVal = customStyles.layout.buttonSize || 'medium';
        resolvedStyles.btnPadding = btnSizeVal === 'small' ? '10px 20px' :
                                   btnSizeVal === 'large' ? '18px 36px' :
                                   '14px 28px';
                                   
        resolvedStyles.labelSpacing = parseInt(customStyles.layout.labelSpacing) || 6;
        resolvedStyles.desktopPadding = parseInt(customStyles.layout.desktopPadding) || 32;
        resolvedStyles.mobilePadding = parseInt(customStyles.layout.mobilePadding) || 16;
        resolvedStyles.fieldGap = parseInt(customStyles.layout.fieldGap) || 16;
        
        resolvedStyles.fontFamily = customStyles.typography.fontFamily || 'sans-serif';
        resolvedStyles.titleSize = parseInt(customStyles.typography.titleSize) || 24;
        resolvedStyles.descSize = parseInt(customStyles.typography.descSize) || 14;
        resolvedStyles.labelSize = parseInt(customStyles.typography.labelSize) || 13;
        resolvedStyles.inputSize = parseInt(customStyles.typography.inputSize) || 14;
        resolvedStyles.btnSize = parseInt(customStyles.typography.btnSize) || 16;
      } else {
        resolvedStyles = {
          bgColor: themeStyles.wrapper.backgroundColor || '#ffffff',
          textColor: themeStyles.wrapper.color || '#1e293b',
          fieldBgColor: themeStyles.input.backgroundColor || '#ffffff',
          fieldBorderColor: themeStyles.input.borderColor || '#cbd5e1',
          labelColor: themeStyles.label.color || '#334155',
          btnBgColor: themeStyles.button.backgroundColor || '#0f172a',
          btnTextColor: themeStyles.button.color || '#ffffff',
          btnHoverBgColor: '',
          successColor: '#10b981',
          successBgColor: '#f0fdf4',
          errorColor: '#ef4444',
          
          formWidth: 800,
          borderRadius: parseInt(themeStyles.wrapper.borderRadius) || 8,
          inputBorderRadius: (themeStyles.input && themeStyles.input.borderRadius) ? parseInt(themeStyles.input.borderRadius) : 0,
          btnBorderRadius: (themeStyles.button && themeStyles.button.borderRadius) ? parseInt(themeStyles.button.borderRadius) : 0,
          shadow: themeStyles.wrapper.boxShadow ? 'medium' : 'none',
          inputPadding: themeStyles.input.padding || '10px',
          btnPadding: themeStyles.button.padding || '12px',
          labelSpacing: 5,
          desktopPadding: parseInt(themeStyles.wrapper.padding) || 24,
          mobilePadding: 16,
          fieldGap: 16,
          
          fontFamily: themeStyles.wrapper.fontFamily || 'sans-serif',
          titleSize: 24,
          descSize: 14,
          labelSize: 13,
          inputSize: 14,
          btnSize: 16
        };

        // Apply presets overrides if not using the App Theme
        if (!isAppTheme) {
          if (preset.bg_color) resolvedStyles.bgColor = preset.bg_color;
          if (preset.text_color) {
            resolvedStyles.textColor = preset.text_color;
            resolvedStyles.labelColor = preset.text_color;
          }
          if (preset.border_color) resolvedStyles.fieldBorderColor = preset.border_color;
          if (preset.input_bg_color) resolvedStyles.fieldBgColor = preset.input_bg_color;
          if (preset.input_border_color) resolvedStyles.fieldBorderColor = preset.input_border_color;
          if (preset.input_text_color) resolvedStyles.textColor = preset.input_text_color;
          if (preset.btn_bg_color) resolvedStyles.btnBgColor = preset.btn_bg_color;
          if (preset.btn_text_color) resolvedStyles.btnTextColor = preset.btn_text_color;
          if (preset.btn_hover_bg_color) resolvedStyles.btnHoverBgColor = preset.btn_hover_bg_color;
          if (preset.success_text_color) resolvedStyles.successColor = preset.success_text_color;
        }

        // Apply Custom Color overrides from Theme Editor settings if presetStyle is 'custom'
        if (presetStyle === 'custom') {
          var blockBgColor = "{{ block.settings.bg_color }}";
          var blockTextColor = "{{ block.settings.text_color }}";
          var blockBorderColor = "{{ block.settings.border_color }}";
          var blockInputBgColor = "{{ block.settings.input_bg_color }}";
          var blockInputTextColor = "{{ block.settings.input_text_color }}";
          var blockInputBorderColor = "{{ block.settings.input_border_color }}";
          var blockBtnBgColor = "{{ block.settings.button_bg_color }}";
          var blockBtnTextColor = "{{ block.settings.button_text_color }}";
          var blockSuccessColor = "{{ block.settings.success_color }}";

          if (blockBgColor && blockBgColor !== '') resolvedStyles.bgColor = blockBgColor;
          if (blockTextColor && blockTextColor !== '') {
            resolvedStyles.textColor = blockTextColor;
            resolvedStyles.labelColor = blockTextColor;
          }
          if (blockBorderColor && blockBorderColor !== '') resolvedStyles.fieldBorderColor = blockBorderColor;
          if (blockInputBgColor && blockInputBgColor !== '') resolvedStyles.fieldBgColor = blockInputBgColor;
          if (blockInputTextColor && blockInputTextColor !== '') resolvedStyles.textColor = blockInputTextColor;
          if (blockInputBorderColor && blockInputBorderColor !== '') resolvedStyles.fieldBorderColor = blockInputBorderColor;
          if (blockBtnBgColor && blockBtnBgColor !== '') resolvedStyles.btnBgColor = blockBtnBgColor;
          if (blockBtnTextColor && blockBtnTextColor !== '') resolvedStyles.btnTextColor = blockBtnTextColor;
          if (blockSuccessColor && blockSuccessColor !== '') resolvedStyles.successColor = blockSuccessColor;
        }

        // Apply Custom Layout overrides from Theme Editor settings (always take precedence)
        var blockFormWidth = "{{ block.settings.form_width }}";
        var blockBorderRadius = "{{ block.settings.border_radius }}";
        var blockButtonRadius = "{{ block.settings.button_radius }}";

        if (blockFormWidth && blockFormWidth !== '') resolvedStyles.formWidth = parseInt(blockFormWidth);
        if (blockBorderRadius && blockBorderRadius !== '') {
          resolvedStyles.borderRadius = parseInt(blockBorderRadius);
          resolvedStyles.inputBorderRadius = parseInt(blockBorderRadius);
        }
        if (blockButtonRadius && blockButtonRadius !== '') resolvedStyles.btnBorderRadius = parseInt(blockButtonRadius);
      }

      // Apply Card style values
      if (cardEl) {
        cardEl.style.backgroundColor = resolvedStyles.bgColor;
        cardEl.style.color = resolvedStyles.textColor;
        cardEl.style.borderRadius = resolvedStyles.borderRadius + 'px';
        cardEl.style.fontFamily = resolvedStyles.fontFamily;

        if (customStyles) {
          cardEl.style.backgroundImage = 'none';
          cardEl.style.maxWidth = resolvedStyles.formWidth + 'px';
          cardEl.style.border = '1px solid ' + resolvedStyles.fieldBorderColor;
        } else {
          if (themeStyles.wrapper.backgroundImage) {
            cardEl.style.backgroundImage = themeStyles.wrapper.backgroundImage;
          }
          var blockBorderColor = !isAppTheme ? (preset.border_color || "{{ block.settings.border_color }}") : "";
          if (blockBorderColor && blockBorderColor !== '') {
            cardEl.style.borderColor = blockBorderColor;
            cardEl.style.borderStyle = 'solid';
          }
        }

        // Card shadow
        var shadowStyle = 'none';
        if (resolvedStyles.shadow === 'subtle') {
          shadowStyle = '0 1px 3px rgba(0,0,0,0.05), 0 1px 2px rgba(0,0,0,0.05)';
        } else if (resolvedStyles.shadow === 'medium') {
          shadowStyle = '0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06)';
        } else if (resolvedStyles.shadow === 'strong') {
          shadowStyle = '0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05), 0 20px 25px -5px rgba(0,0,0,0.1)';
        }
        cardEl.style.boxShadow = shadowStyle;

        // Card responsive padding
        var setResponsivePadding = function() {
          if (window.innerWidth <= 600) {
            cardEl.style.padding = resolvedStyles.mobilePadding + 'px';
          } else {
            cardEl.style.padding = resolvedStyles.desktopPadding + 'px';
          }
        };
        setResponsivePadding();
        window.addEventListener('resize', setResponsivePadding);

        // Handle Glassmorphism inner box reset
        if (customStyles) {
          cardEl.style.backgroundColor = resolvedStyles.bgColor;
          cardEl.style.backdropFilter = 'none';
          cardEl.style.webkitBackdropFilter = 'none';
        } else if (themeStyles.innerWrapper) {
          Object.assign(cardEl.style, themeStyles.innerWrapper);
          var sectEl = root.querySelector('.pandaforms-section') || root;
          sectEl.style.backgroundImage = themeStyles.wrapper.backgroundImage;
          sectEl.style.color = themeStyles.wrapper.color;
        }
      }

      // Titles/Desc styles
      if (titleEl) {
        titleEl.style.fontSize = resolvedStyles.titleSize + 'px';
        titleEl.style.color = resolvedStyles.textColor;
        titleEl.style.fontFamily = resolvedStyles.fontFamily;
      }
      if (descEl) {
        descEl.style.fontSize = resolvedStyles.descSize + 'px';
        descEl.style.color = resolvedStyles.textColor;
        descEl.style.fontFamily = resolvedStyles.fontFamily;
        descEl.style.opacity = '0.8';
      }

      // Set fields container gap
      if (fieldsWrap) {
        fieldsWrap.style.gap = resolvedStyles.fieldGap + 'px';
      }
      
      // Render Fields
      fieldsWrap.innerHTML = '';
      var fields = form.fields || [];
      fields.forEach(function(field) {
        var fieldWrapper = document.createElement('div');
        fieldWrapper.className = 'pandaforms-field-wrapper ' + (field.width === 'third' ? 'width-third' : field.width === 'half' ? 'width-half' : 'width-full');
        fieldWrapper.style.display = field.type === 'hidden' ? 'none' : 'flex';
        fieldWrapper.style.flexDirection = 'column';
        fieldWrapper.style.boxSizing = 'border-box';
        
        // Dynamic styling for responsive width
        if (field.width === 'third') {
          fieldWrapper.style.flex = '1 1 calc(33.33% - ' + (resolvedStyles.fieldGap * 2 / 3) + 'px)';
          fieldWrapper.style.minWidth = '180px';
        } else if (field.width === 'half') {
          fieldWrapper.style.flex = '1 1 calc(50% - ' + (resolvedStyles.fieldGap / 2) + 'px)';
          fieldWrapper.style.minWidth = '240px';
        } else {
          fieldWrapper.style.flex = '1 1 100%';
        }
        
        if (field.type === 'step') {
          fieldWrapper.style.width = '100%';
          fieldWrapper.style.flex = '1 1 100%';
          fieldWrapper.style.borderBottom = '2px dashed ' + resolvedStyles.fieldBorderColor;
          fieldWrapper.style.paddingBottom = '8px';
          fieldWrapper.style.marginTop = '16px';
          fieldWrapper.style.marginBottom = '8px';
          
          var spanEl = document.createElement('span');
          spanEl.style.fontSize = '12px';
          spanEl.style.fontWeight = '700';
          spanEl.style.textTransform = 'uppercase';
          spanEl.style.letterSpacing = '0.05em';
          spanEl.style.color = resolvedStyles.textColor;
          spanEl.innerText = '📍 ' + (field.label || 'Step Divider');
          
          fieldWrapper.appendChild(spanEl);
        } else if (field.type === 'title') {
          fieldWrapper.style.width = '100%';
          fieldWrapper.style.flex = '1 1 100%';
          fieldWrapper.style.marginTop = '12px';
          fieldWrapper.style.marginBottom = '4px';
          
          var h3El = document.createElement('h3');
          h3El.style.margin = '0';
          h3El.style.fontSize = '18px';
          h3El.style.fontWeight = '600';
          h3El.style.color = resolvedStyles.textColor;
          h3El.innerText = field.label || 'Section Title';
          
          fieldWrapper.appendChild(h3El);
        } else if (field.type === 'description') {
          fieldWrapper.style.width = '100%';
          fieldWrapper.style.flex = '1 1 100%';
          fieldWrapper.style.marginTop = '4px';
          fieldWrapper.style.marginBottom = '8px';
          
          var pEl = document.createElement('p');
          pEl.style.margin = '0';
          pEl.style.fontSize = '14px';
          pEl.style.color = resolvedStyles.textColor;
          pEl.style.opacity = '0.8';
          pEl.style.lineHeight = '1.4';
          pEl.innerText = field.label || 'Description text';
          
          fieldWrapper.appendChild(pEl);
        } else {
          // Regular form fields
          fieldWrapper.style.gap = resolvedStyles.labelSpacing + 'px';

          var labelEl = document.createElement('label');
          labelEl.style.fontWeight = '600';
          labelEl.style.fontSize = resolvedStyles.labelSize + 'px';
          labelEl.style.color = resolvedStyles.labelColor;
          labelEl.style.fontFamily = resolvedStyles.fontFamily;
          labelEl.innerHTML = field.label + ' ' + (field.required ? '<span style="color: red;">*</span>' : '');
          fieldWrapper.appendChild(labelEl);
          
          var inputEl;
          
          // Safely parse options array from choices column
          var parsedChoices = [];
          try {
            if (field.choices && (field.choices.indexOf('[') === 0 || field.choices.indexOf('{') === 0)) {
              parsedChoices = JSON.parse(field.choices);
            } else if (field.choices) {
              parsedChoices = field.choices.split(',').map(function(c) { return { label: c.trim(), value: c.trim() }; });
            }
          } catch (e) {
            parsedChoices = (field.choices || '').split(',').map(function(c) { return { label: c.trim(), value: c.trim() }; });
          }

          if (field.type === 'textarea') {
            inputEl = document.createElement('textarea');
            inputEl.style.minHeight = '80px';
            inputEl.placeholder = field.placeholder || '';
          } else if (field.type === 'select') {
            inputEl = document.createElement('select');
            parsedChoices.forEach(function(choice) {
              var opt = document.createElement('option');
              opt.value = choice.value || choice.label;
              opt.innerText = choice.label;
              inputEl.appendChild(opt);
            });
          } else if (field.type === 'radio') {
            inputEl = document.createElement('div');
            inputEl.style.display = 'flex';
            inputEl.style.flexDirection = 'column';
            inputEl.style.gap = '5px';
            parsedChoices.forEach(function(choice, i) {
              var lbl = document.createElement('label');
              lbl.style.fontSize = resolvedStyles.inputSize + 'px';
              lbl.style.fontFamily = resolvedStyles.fontFamily;
              lbl.style.color = resolvedStyles.textColor;
              lbl.style.display = 'flex';
              lbl.style.gap = '8px';
              
              var rad = document.createElement('input');
              rad.type = 'radio';
              rad.name = 'field_' + field.id;
              rad.value = choice.value || choice.label;
              if (choice.defaultChecked || (field.required && i === 0)) rad.checked = true;
              
              lbl.appendChild(rad);
              lbl.appendChild(document.createTextNode(choice.label));
              inputEl.appendChild(lbl);
            });
          } else if (field.type === 'checkbox_list') {
            inputEl = document.createElement('div');
            inputEl.style.display = 'flex';
            inputEl.style.flexDirection = 'column';
            inputEl.style.gap = '5px';
            parsedChoices.forEach(function(choice) {
              var lbl = document.createElement('label');
              lbl.style.fontSize = resolvedStyles.inputSize + 'px';
              lbl.style.fontFamily = resolvedStyles.fontFamily;
              lbl.style.color = resolvedStyles.textColor;
              lbl.style.display = 'flex';
              lbl.style.gap = '8px';
              
              var chk = document.createElement('input');
              chk.type = 'checkbox';
              chk.name = 'field_' + field.id;
              chk.value = choice.value || choice.label;
              if (choice.defaultChecked) chk.checked = true;
              
              lbl.appendChild(chk);
              lbl.appendChild(document.createTextNode(choice.label));
              inputEl.appendChild(lbl);
            });
          } else if (field.type === 'checkbox') {
            inputEl = document.createElement('label');
            inputEl.style.fontSize = resolvedStyles.inputSize + 'px';
            inputEl.style.fontFamily = resolvedStyles.fontFamily;
            inputEl.style.color = resolvedStyles.textColor;
            inputEl.style.display = 'flex';
            inputEl.style.gap = '8px';
            
            var chk = document.createElement('input');
            chk.type = 'checkbox';
            chk.name = 'field_' + field.id;
            chk.required = field.required;
            
            inputEl.appendChild(chk);
            inputEl.appendChild(document.createTextNode(field.placeholder || "Confirm / Agree"));
          } else {
            inputEl = document.createElement('input');
            inputEl.type = field.type;
            
            // Inject Default Phone Prefix if configured & type is phone
            if (field.type === 'phone' && form.defaultCountryPhoneCode) {
              inputEl.value = form.defaultCountryPhoneCode.split(' ')[0] || '';
            }
            
            if (field.type !== 'hidden') {
              inputEl.placeholder = field.placeholder || '';
            }
          }
          
          if (field.type !== 'radio' && field.type !== 'checkbox' && field.type !== 'checkbox_list') {
            inputEl.name = 'field_' + field.id;
            inputEl.required = field.required;
            inputEl.style.padding = resolvedStyles.inputPadding;
            inputEl.style.fontSize = resolvedStyles.inputSize + 'px';
            inputEl.style.width = '100%';
            inputEl.style.boxSizing = 'border-box';
            inputEl.style.backgroundColor = resolvedStyles.fieldBgColor;
            inputEl.style.border = '1px solid ' + resolvedStyles.fieldBorderColor;
            inputEl.style.borderRadius = resolvedStyles.inputBorderRadius + 'px';
            inputEl.style.color = resolvedStyles.textColor;
            inputEl.style.outline = 'none';
          }
          
          inputEl.dataset.label = field.label;
          inputEl.dataset.type = field.type;
          
          fieldWrapper.appendChild(inputEl);
        }
        
        fieldsWrap.appendChild(fieldWrapper);
      });

      // Apply button style values
      if (submitBtn) {
        submitBtn.style.padding = resolvedStyles.btnPadding;
        submitBtn.style.fontSize = resolvedStyles.btnSize + 'px';
        submitBtn.style.fontFamily = resolvedStyles.fontFamily;
        submitBtn.style.borderRadius = resolvedStyles.btnBorderRadius + 'px';
        submitBtn.style.backgroundColor = resolvedStyles.btnBgColor;
        submitBtn.style.color = resolvedStyles.btnTextColor;

        // Apply button box shadow
        var btnShadowStyle = 'none';
        if (resolvedStyles.shadow === 'subtle') {
          btnShadowStyle = '0 1px 3px rgba(0,0,0,0.05)';
        } else if (resolvedStyles.shadow === 'medium') {
          btnShadowStyle = '0 4px 6px -1px rgba(0,0,0,0.1)';
        } else if (resolvedStyles.shadow === 'strong') {
          btnShadowStyle = '0 10px 15px -3px rgba(0,0,0,0.1)';
        }
        submitBtn.style.boxShadow = btnShadowStyle;

        // Setup hover transitions and scale animation dynamically
        submitBtn.style.transition = 'background-color 0.2s ease, transform 0.1s ease';
        var originalBtnBg = submitBtn.style.backgroundColor;
        submitBtn.addEventListener('mouseenter', function() {
          if (resolvedStyles.btnHoverBgColor && resolvedStyles.btnHoverBgColor !== '') {
            submitBtn.style.backgroundColor = resolvedStyles.btnHoverBgColor;
          } else {
            submitBtn.style.opacity = '0.9';
          }
        });
        submitBtn.addEventListener('mouseleave', function() {
          if (resolvedStyles.btnHoverBgColor && resolvedStyles.btnHoverBgColor !== '') {
            submitBtn.style.backgroundColor = originalBtnBg;
          } else {
            submitBtn.style.opacity = '1';
          }
        });
        submitBtn.addEventListener('mousedown', function() {
          submitBtn.style.transform = 'scale(0.98)';
        });
        submitBtn.addEventListener('mouseup', function() {
          submitBtn.style.transform = 'scale(1)';
        });
      }
      
      // Apply success state styles
      if (success) {
        success.style.color = resolvedStyles.successColor;
        success.style.backgroundColor = resolvedStyles.successBgColor;
        success.style.borderRadius = resolvedStyles.borderRadius + 'px';
        success.style.border = '1px solid ' + resolvedStyles.successColor;
      }
      
      loading.style.display = 'none';
      content.style.display = 'block';
    }).catch(function(err) {
      console.error(err);
      showError('PandaForms: Form could not load. Please check Form ID and app URL.');
    });
  }

  formEl.addEventListener('submit', function(e) {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.style.opacity = '.65';
    submitBtn.textContent = 'Submitting...';
    var payload = {};
    Array.prototype.forEach.call(formEl.elements, function(el) {
      if (el.name) payload[el.name] = el.value;
    });
    var proxySubmit = '/apps/pandaforms/submit';
    var directSubmit = apiUrl + '/api/submit';
    function post(url) {
      return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ formId: formId, fields: payload })
      });
    }
    post(proxySubmit).then(function(res) {
      if (!res.ok) throw new Error('proxy submit failed');
      return res.json();
    }).catch(function() {
      return post(directSubmit).then(function(res) { return res.json(); });
    }).then(function(res) {
      if (res && res.success) {
        if (redirectUrl) window.location.href = redirectUrl;
        content.style.display = 'none';
        success.style.display = 'block';
      } else {
        alert((res && res.error) || 'Submission failed. Please try again.');
      }
    }).catch(function(err) {
      console.error(err);
      alert('Submission failed. Please try again.');
    }).finally(function() {
      submitBtn.disabled = false;
      submitBtn.style.opacity = '1';
      submitBtn.textContent = {{ block.settings.button_text | json }};
    });
  });

  loadForm();
})();
</script>

