{% comment %}
  PandaForms section app block
  This block appears in Online Store > Theme Editor > Add section > Apps.
{% endcomment %}

{%- assign spacing_px = '24px' -%}
{%- if block.settings.card_spacing == 'none' -%}
  {%- assign spacing_px = '0px' -%}
{%- elsif block.settings.card_spacing == 'small' -%}
  {%- assign spacing_px = '12px' -%}
{%- elsif block.settings.card_spacing == 'large' -%}
  {%- assign spacing_px = '48px' -%}
{%- elsif block.settings.card_spacing == 'huge' -%}
  {%- assign spacing_px = '80px' -%}
{%- endif -%}

<section class="pandaforms-section" id="pandaforms-{{ block.id }}" style="padding-top: {{ spacing_px }}; padding-bottom: {{ spacing_px }}; width: 100%;">
  <div class="pandaforms-card" style="max-width: {{ block.settings.form_width }}px; margin: 0 auto; padding: 28px; border-radius: {{ block.settings.border_radius }}px; background: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }}; border: 1px solid {{ block.settings.border_color }};">
    <div class="pandaforms-loading" style="text-align:center; padding: 16px;">Loading PandaForms...</div>
    <div class="pandaforms-content" style="display:none;">
      <h2 class="pandaforms-title" style="margin: 0 0 8px; text-align:center; color: {{ block.settings.text_color }};"></h2>
      <p class="pandaforms-desc" style="margin: 0 0 22px; text-align:center; color: {{ block.settings.text_color }}; opacity:.78;"></p>
      <form class="pandaforms-form" style="display:flex; flex-direction:column; gap:16px;">
        <div class="pandaforms-fields" style="display:flex; flex-wrap:wrap; gap:16px;"></div>
        <button type="submit" class="pandaforms-submit" style="width:100%; padding:13px 16px; border:0; border-radius:{{ block.settings.button_radius }}px; background:{{ block.settings.button_bg_color }}; color:{{ block.settings.button_text_color }}; font-weight:700; cursor:pointer;">
          {{ block.settings.button_text }}
        </button>
      </form>
    </div>
    <div class="pandaforms-success" style="display:none; text-align:center; padding:20px; color: {{ block.settings.success_color }};">
      <h3 style="margin:0 0 8px;">Success</h3>
      <p class="pandaforms-success-msg" style="margin:0;"></p>
    </div>
  </div>
</section>

<script>
(function() {
  var blockId = {{ block.id | json }};
  var formId = {{ block.settings.form_id | json }};
  var apiUrl = {{ block.settings.api_url | json }}.replace(/\/$/, '');
  var root = document.getElementById('pandaforms-' + blockId);
  if (!root) return;
  var loading = root.querySelector('.pandaforms-loading');
  var content = root.querySelector('.pandaforms-content');
  var fieldsWrap = root.querySelector('.pandaforms-fields');
  var formEl = root.querySelector('.pandaforms-form');
  var success = root.querySelector('.pandaforms-success');
  var submitBtn = root.querySelector('.pandaforms-submit');
  var redirectUrl = '';
  var themeStyles = {};

  function showError(message) {
    loading.innerHTML = '<p style="color:#b42318; margin:0;">' + message + '</p>';
  }

  if (!formId) {
    showError('PandaForms: Please add the Form ID from the PandaForms app.');
    return;
  }

  function toStyleString(obj) {
    if (!obj) return '';
    return Object.keys(obj).map(function(key) {
      var kebab = key.replace(/([A-Z])/g, '-$1').toLowerCase();
      return kebab + ':' + obj[key];
    }).join(';') + ';';
  }

  function getThemeStyles(selectedTheme) {
    switch (selectedTheme) {
      case 'dark':
        return {
          wrapper: { backgroundColor: '#0f172a', color: '#f8fafc', padding: '32px', borderRadius: '12px', border: '1px solid #334155' },
          title: { color: '#f8fafc' },
          desc: { color: '#94a3b8' },
          label: { color: '#cbd5e1' },
          input: { backgroundColor: '#1e293b', border: '1px solid #475569', color: '#f8fafc', borderRadius: '6px' },
          button: { backgroundColor: '#10b981', color: '#ffffff', border: 'none', borderRadius: '6px' }
        };
      case 'glassmorphism':
        return {
          wrapper: { backgroundImage: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)', color: '#ffffff', padding: '0', border: 'none' },
          innerWrapper: { backgroundColor: 'rgba(255, 255, 255, 0.15)', backdropFilter: 'blur(12px)', WebkitBackdropFilter: 'blur(12px)', borderRadius: '16px', border: '1px solid rgba(255, 255, 255, 0.2)', boxShadow: '0 8px 32px 0 rgba(31, 38, 135, 0.37)', padding: '32px' },
          title: { color: '#ffffff' },
          desc: { color: 'rgba(255, 255, 255, 0.8)' },
          label: { color: '#ffffff' },
          input: { backgroundColor: 'rgba(255, 255, 255, 0.2)', border: '1px solid rgba(255, 255, 255, 0.3)', color: '#ffffff', borderRadius: '10px' },
          button: { backgroundColor: '#ffffff', color: '#764ba2', border: 'none', borderRadius: '10px' }
        };
      case 'playful':
        return {
          wrapper: { backgroundColor: '#fef08a', color: '#1c1917', padding: '32px', borderRadius: '0px', border: '3px solid #1c1917', boxShadow: '8px 8px 0px #1c1917' },
          title: { color: '#1c1917' },
          desc: { color: '#44403c' },
          label: { color: '#1c1917' },
          input: { backgroundColor: '#ffffff', border: '3px solid #1c1917', color: '#1c1917', borderRadius: '0px', boxShadow: '4px 4px 0px #1c1917' },
          button: { backgroundColor: '#f43f5e', color: '#ffffff', border: '3px solid #1c1917', borderRadius: '0px', boxShadow: '4px 4px 0px #1c1917' }
        };
      case 'classic':
        return {
          wrapper: { backgroundColor: '#f6f6f7', color: '#202223', padding: '24px', borderRadius: '4px', border: '1px solid #e1e3e5' },
          title: { color: '#202223' },
          desc: { color: '#6d7175' },
          label: { color: '#202223' },
          input: { backgroundColor: '#ffffff', border: '1px solid #8c9196', color: '#202223', borderRadius: '4px' },
          button: { backgroundColor: '#008060', color: '#ffffff', border: 'none', borderRadius: '4px' }
        };
      case 'minimal':
      default:
        return {
          wrapper: { backgroundColor: '#ffffff', color: '#1e293b', padding: '24px', borderRadius: '8px', border: '1px solid #e2e8f0' },
          title: { color: '#0f172a' },
          desc: { color: '#64748b' },
          label: { color: '#334155' },
          input: { backgroundColor: '#ffffff', border: 'none', borderBottom: '2px solid #cbd5e1', color: '#1e293b', borderRadius: '0px' },
          button: { backgroundColor: '#0f172a', color: '#ffffff', border: 'none', borderRadius: '8px' }
        };
    }
  }

  function fieldInput(field) {
    var label = field.label || field.name || 'Field';
    var key = field.key || field.id || label.toLowerCase().replace(/[^a-z0-9]+/g, '_');
    var type = field.type || 'text';
    var required = field.required ? 'required' : '';
    var placeholder = field.placeholder || '';
    
    // Determine flex width percentage
    var pct = '100';
    var minW = '100%';
    if (field.width === 'half') {
      pct = '50';
      minW = '240px';
    } else if (field.width === 'third') {
      pct = '33.33';
      minW = '180px';
    }
    
    var labelStyle = toStyleString(themeStyles.label || {});
    var inputStyle = toStyleString(themeStyles.input || {});
    
    var html = '<div style="flex: 1 1 calc(' + pct + '% - 16px); min-width: ' + minW + '; box-sizing: border-box; display: flex; flex-direction: column; gap: 6px;">';
    html += '<label style="display:block; margin:0 0 6px; font-weight:600;' + labelStyle + '">' + label + (field.required ? ' <span style="color:#d72c0d;">*</span>' : '') + '</label>';
    if (type === 'textarea') {
      html += '<textarea name="' + key + '" placeholder="' + placeholder + '" ' + required + ' style="width:100%; min-height:110px; padding:11px 12px; box-sizing:border-box;' + inputStyle + '"></textarea>';
    } else {
      var inputType = type === 'email' ? 'email' : type === 'phone' ? 'tel' : type === 'date' ? 'date' : 'text';
      html += '<input type="' + inputType + '" name="' + key + '" placeholder="' + placeholder + '" ' + required + ' style="width:100%; padding:11px 12px; box-sizing:border-box;' + inputStyle + '" />';
    }
    html += '</div>';
    return html;
  }

  function loadForm() {
    var proxyUrl = '/apps/pandaforms/form-config?id=' + encodeURIComponent(formId);
    var directUrl = apiUrl + '/api/form-config?id=' + encodeURIComponent(formId);
    fetch(proxyUrl).then(function(res) {
      if (!res.ok) throw new Error('proxy failed');
      return res.json();
    }).catch(function() {
      return fetch(directUrl).then(function(res) {
        if (!res.ok) throw new Error('direct failed');
        return res.json();
      });
    }).then(function(data) {
      var form = data.form || data;
      
      // Initialize theme styles
      var theme = form.theme || 'minimal';
      themeStyles = getThemeStyles(theme);
      
      // Apply theme styles to Card
      var cardEl = root.querySelector('.pandaforms-card');
      if (cardEl) {
        Object.assign(cardEl.style, themeStyles.wrapper);
        if (themeStyles.innerWrapper) {
          Object.assign(cardEl.style, themeStyles.innerWrapper);
          var sectEl = root.querySelector('.pandaforms-section') || root;
          sectEl.style.backgroundImage = themeStyles.wrapper.backgroundImage;
          sectEl.style.color = themeStyles.wrapper.color;
        }
      }
      
      var titleEl = root.querySelector('.pandaforms-title');
      if (titleEl) {
        titleEl.textContent = form.title || form.name || 'PandaForms';
        Object.assign(titleEl.style, themeStyles.title || {});
      }
      
      var descEl = root.querySelector('.pandaforms-desc');
      if (descEl) {
        descEl.textContent = form.description || '';
        Object.assign(descEl.style, themeStyles.desc || {});
      }
      
      var submitBtnEl = root.querySelector('.pandaforms-submit');
      if (submitBtnEl) {
        Object.assign(submitBtnEl.style, themeStyles.button || {});
      }
      
      root.querySelector('.pandaforms-success-msg').textContent = form.successMessage || 'Thank you. Your form has been submitted.';
      redirectUrl = form.redirectUrl || '';
      var fields = form.fields || [];
      fieldsWrap.innerHTML = fields.map(fieldInput).join('');
      loading.style.display = 'none';
      content.style.display = 'block';
    }).catch(function(err) {
      console.error(err);
      showError('PandaForms: Form could not load. Please check Form ID and app URL.');
    });
  }

  formEl.addEventListener('submit', function(e) {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.style.opacity = '.65';
    submitBtn.textContent = 'Submitting...';
    var payload = {};
    Array.prototype.forEach.call(formEl.elements, function(el) {
      if (el.name) payload[el.name] = el.value;
    });
    var proxySubmit = '/apps/pandaforms/submit';
    var directSubmit = apiUrl + '/api/submit';
    function post(url) {
      return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ formId: formId, fields: payload })
      });
    }
    post(proxySubmit).then(function(res) {
      if (!res.ok) throw new Error('proxy submit failed');
      return res.json();
    }).catch(function() {
      return post(directSubmit).then(function(res) { return res.json(); });
    }).then(function(res) {
      if (res && res.success) {
        if (redirectUrl) window.location.href = redirectUrl;
        content.style.display = 'none';
        success.style.display = 'block';
      } else {
        alert((res && res.error) || 'Submission failed. Please try again.');
      }
    }).catch(function(err) {
      console.error(err);
      alert('Submission failed. Please try again.');
    }).finally(function() {
      submitBtn.disabled = false;
      submitBtn.style.opacity = '1';
      submitBtn.textContent = {{ block.settings.button_text | json }};
    });
  });

  loadForm();
})();
</script>

{% schema %}
{
  "name": "PandaForms Widget",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Form Setup" },
    { "type": "text", "id": "form_id", "label": "Form ID", "placeholder": "Paste Form ID from PandaForms" },
    { "type": "text", "id": "api_url", "label": "App URL", "default": "https://p01--pandaforms-app--77wd8gj6rv7k.code.run" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "card_spacing",
      "label": "Top & Bottom Spacing",
      "default": "medium",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "huge", "label": "Extra Large" }
      ]
    },
    { "type": "range", "id": "form_width", "label": "Form Width", "min": 420, "max": 1200, "step": 20, "default": 800 },
    { "type": "range", "id": "border_radius", "label": "Card Radius", "min": 0, "max": 32, "step": 2, "default": 8 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Card Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#202223" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#e1e3e5" },
    { "type": "color", "id": "input_bg_color", "label": "Input Background", "default": "#ffffff" },
    { "type": "color", "id": "input_text_color", "label": "Input Text", "default": "#202223" },
    { "type": "color", "id": "input_border_color", "label": "Input Border", "default": "#8c9196" },
    { "type": "color", "id": "button_bg_color", "label": "Button Background", "default": "#008060" },
    { "type": "color", "id": "button_text_color", "label": "Button Text", "default": "#ffffff" },
    { "type": "color", "id": "success_color", "label": "Success Text", "default": "#008060" },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Submit" },
    { "type": "range", "id": "button_radius", "label": "Button Radius", "min": 0, "max": 32, "step": 2, "default": 6 }
  ]
}
{% endschema %}
