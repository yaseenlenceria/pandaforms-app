{%- assign spacing_px = '24px' -%}
{%- if block.settings.card_spacing == 'none' -%}{%- assign spacing_px = '0px' -%}
{%- elsif block.settings.card_spacing == 'small' -%}{%- assign spacing_px = '12px' -%}
{%- elsif block.settings.card_spacing == 'large' -%}{%- assign spacing_px = '48px' -%}
{%- elsif block.settings.card_spacing == 'huge' -%}{%- assign spacing_px = '80px' -%}
{%- endif -%}
{%- assign widget_color_scheme = block.settings.color_scheme | default: 'scheme-1' -%}

<div class="pandaforms-widget-shell color-{{ widget_color_scheme }} gradient" style="padding-top: {{ spacing_px }}; padding-bottom: {{ spacing_px }}; width: 100%;">
<div class="pandaforms-wrapper" id="pandaforms-{{ block.id }}" style="margin: 0 auto; font-family: sans-serif; box-sizing: border-box;">

  <div class="pandaforms-loading" style="text-align: center; padding: 20px;">
    <p>Loading form...</p>
  </div>

  <div class="pandaforms-content" style="display: none;">
    <h2 class="pandaforms-title" style="margin-bottom: 8px; text-align: center;"></h2>
    <p class="pandaforms-desc" style="margin-bottom: 20px; text-align: center; opacity: 0.8;"></p>

    <form class="pandaforms-form" style="display: flex; flex-direction: column; gap: 15px;">
      <!-- Login Link Top Container -->
      <div class="pandaforms-login-top" style="display: none; text-align: center; margin-bottom: 15px; font-size: 14px;">
        <span class="pandaforms-login-prefix-top"></span>
        <a class="pandaforms-login-link-top" href="{{ routes.account_login_url }}" style="margin-left: 5px; font-weight: 600; text-decoration: underline;"></a>
      </div>

      <!-- Fields flexbox wrapper -->
      <div class="pandaforms-fields-container" style="display: flex; flex-wrap: wrap; gap: 16px;"></div>

      <!-- Submit Button -->
      <div style="width: 100%;">
        <button type="submit" class="pandaforms-submit-btn" style="border: none; font-weight: 600; cursor: pointer; width: 100%; margin-top: 10px;">Submit</button>
      </div>

      <!-- Login Link Bottom Container -->
      <div class="pandaforms-login-bottom" style="display: none; text-align: center; margin-top: 15px; font-size: 14px;">
        <span class="pandaforms-login-prefix-bottom"></span>
        <a class="pandaforms-login-link-bottom" href="{{ routes.account_login_url }}" style="margin-left: 5px; font-weight: 600; text-decoration: underline;"></a>
      </div>
    </form>
  </div>

  <div class="pandaforms-success" style="display: none; text-align: center; padding: 20px;">
    <h3 style="margin-bottom: 10px; font-size: 20px;">✓ Success</h3>
    <p class="pandaforms-success-msg"></p>
  </div>

</div>
</div>

<script>
(function() {
  var blockId = "{{ block.id }}";
  var formId = "";
  var apiUrl = "https://p01--pandaforms-app--77wd8gj6rv7k.code.run";
  var useAppStyling = {{ block.settings.use_app_styling | default: true | json }};
  var adoptThemeStyling = {{ block.settings.adopt_theme_styling | default: false | json }};
  var widgetFontSource = {{ block.settings.widget_font_source | default: "app" | json }};
  var overrideWidth = {{ block.settings.override_width | default: false | json }};
  var blockWidth = parseInt("{{ block.settings.form_width | default: 650 }}") || 650;

  var wrapper = document.getElementById("pandaforms-" + blockId);
  var loadingDiv = wrapper.querySelector(".pandaforms-loading");
  var contentDiv = wrapper.querySelector(".pandaforms-content");
  var successDiv = wrapper.querySelector(".pandaforms-success");
  var fieldsContainer = wrapper.querySelector(".pandaforms-fields-container");
  var formEl = wrapper.querySelector(".pandaforms-form");
  var submitBtn = wrapper.querySelector(".pandaforms-submit-btn");

  var redirectUrl = "";
  var configEndpoint = "/apps/pandaforms/form-config?t=" + Date.now();
  var directConfigEndpoint = apiUrl + "/api/form-config?t=" + Date.now();
  var submitEndpoint = "/apps/pandaforms/submit";
  var directSubmitEndpoint = apiUrl + "/api/submit";

  // ---------------------------------------------------------------------------
  // Default fallback preset (Shopify Default) — only used when no customStyles
  // are saved in the app and Use App Styling is ON.
  // ---------------------------------------------------------------------------
  var FALLBACK_PRESET = {
    colors: {
      bgColor: "#ffffff",
      textColor: "#1e293b",
      fieldBgColor: "#ffffff",
      fieldBorderColor: "#cbd5e1",
      btnBgColor: "#008060",
      btnTextColor: "#ffffff",
      btnHoverColor: "#005e46",
      successColor: "#10b981",
      successBgColor: "#f0fdf4",
      errorColor: "#ef4444"
    },
    layout: {
      formWidth: "650",
      borderRadius: "4",
      spacing: "16",
      shadow: "subtle",
      inputSize: "medium",
      buttonSize: "medium"
    },
    typography: {
      fontFamily: "Inter, sans-serif",
      titleSize: "24",
      descSize: "14",
      labelSize: "13",
      inputSize: "14",
      btnSize: "15"
    }
  };

  // ---------------------------------------------------------------------------
  // Fetch form config from the Shopify App Proxy
  // ---------------------------------------------------------------------------
  fetch(configEndpoint, {
    headers: {
      "ngrok-skip-browser-warning": "true",
      "bypass-tunnel-reminder": "true"
    }
  })
  .then(function(res) {
    if (!res.ok) throw new Error("App proxy config fetch failed: " + res.status);
    return res.json();
  })
  .catch(function() {
    return fetch(directConfigEndpoint, {
      headers: {
        "ngrok-skip-browser-warning": "true",
        "bypass-tunnel-reminder": "true"
      }
    }).then(function(res) {
      if (!res.ok) throw new Error("Direct config fetch failed: " + res.status);
      return res.json();
    });
  })
  .then(function(data) {
    var form = data.form;
    if (!form) throw new Error("No form data returned");
    formId = form.id;

    // Populate static text
    wrapper.querySelector(".pandaforms-title").innerText = form.title || "";
    wrapper.querySelector(".pandaforms-desc").innerText = form.description || "";
    wrapper.querySelector(".pandaforms-success-msg").innerText = form.successMessage || "Thank you!";
    redirectUrl = form.redirectUrl || "";

    // -------------------------------------------------------------------------
    // Resolve design: always read from form.customStyles saved in the app.
    // The Shopify Theme Editor has NO colour controls — it only places the widget.
    // -------------------------------------------------------------------------
    var savedStyles = null;
    if (form.customStyles) {
      try { savedStyles = JSON.parse(form.customStyles); } catch(e) {}
    }

    var useThemeFont = widgetFontSource === "theme_body" || widgetFontSource === "theme_heading";

    // activeStyles = app-saved styles, or fallback preset, or null (theme default).
    // Theme adoption keeps PandaForms layout while using Shopify theme fonts and colours.
    var activeStyles = (useAppStyling || adoptThemeStyling || useThemeFont) ? (savedStyles || FALLBACK_PRESET) : null;

    // -------------------------------------------------------------------------
    // Build resolved flat styles from activeStyles
    // -------------------------------------------------------------------------
    var s = {}; // resolved styles shorthand

    if (activeStyles) {
      var c  = activeStyles.colors   || {};
      var l  = activeStyles.layout   || {};
      var t  = activeStyles.typography || {};

      // Colours
      s.bgColor          = c.bgColor          || "#ffffff";
      s.textColor        = c.textColor        || "#1e293b";
      s.labelColor       = c.labelColor       || c.textColor || "#334155";
      s.fieldBgColor     = c.fieldBgColor     || "#ffffff";
      s.fieldBorderColor = c.fieldBorderColor || "#cbd5e1";
      s.btnBgColor       = c.btnBgColor       || "#008060";
      s.btnTextColor     = c.btnTextColor     || "#ffffff";
      s.btnHoverColor    = c.btnHoverColor    || "";
      s.successColor     = c.successColor     || "#10b981";
      s.successBgColor   = c.successBgColor   || "#f0fdf4";

      // Layout — single spacing value drives all derived spacing
      var spacing        = parseInt(l.spacing || l.fieldGap || 16);
      s.formWidth        = overrideWidth ? blockWidth : (parseInt(l.formWidth) || 650);
      s.borderRadius     = parseInt(l.borderRadius) || 4;
      s.shadow           = l.shadow || "subtle";
      s.fieldGap         = spacing;
      s.desktopPadding   = spacing * 2;
      s.mobilePadding    = spacing;
      s.labelSpacing     = Math.round(spacing / 2.5);

      var inputSz = l.inputSize || "medium";
      s.inputPadding = inputSz === "small" ? "8px 12px" : inputSz === "large" ? "16px 20px" : "12px 16px";
      var btnSz = l.buttonSize || "medium";
      s.btnPadding   = btnSz === "small" ? "10px 20px" : btnSz === "large" ? "18px 36px" : "14px 28px";
      s.btnSize      = parseInt(t.btnSize) || 16;

      // Typography
      s.fontFamily  = t.fontFamily  || "sans-serif";
      s.titleSize   = parseInt(t.titleSize)  || 24;
      s.descSize    = parseInt(t.descSize)   || 14;
      s.labelSize   = parseInt(t.labelSize)  || 13;
      s.inputSize   = parseInt(t.inputSize)  || 14;

      if (adoptThemeStyling) {
        s.bgColor          = "rgb(var(--color-background, 255, 255, 255))";
        s.textColor        = "rgb(var(--color-foreground, 18, 18, 18))";
        s.labelColor       = "rgb(var(--color-foreground, 18, 18, 18))";
        s.fieldBgColor     = "rgb(var(--color-background, 255, 255, 255))";
        s.fieldBorderColor = "rgba(var(--color-foreground, 18, 18, 18), 0.22)";
        s.btnBgColor       = "rgb(var(--color-button, var(--color-foreground, 18, 18, 18)))";
        s.btnTextColor     = "rgb(var(--color-button-text, var(--color-background, 255, 255, 255)))";
        s.btnHoverColor    = "";
      }

      if (widgetFontSource === "theme_body" || adoptThemeStyling) {
        s.fontFamily = "var(--font-body-family, inherit)";
      } else if (widgetFontSource === "theme_heading") {
        s.fontFamily = "var(--font-heading-family, var(--font-body-family, inherit))";
      }

      // -----------------------------------------------------------------------
      // Apply wrapper styles from saved app design
      // -----------------------------------------------------------------------
      wrapper.style.backgroundColor = s.bgColor;
      wrapper.style.color           = s.textColor;
      wrapper.style.fontFamily      = s.fontFamily;
      wrapper.style.maxWidth        = s.formWidth + "px";
      wrapper.style.borderRadius    = s.borderRadius + "px";
      wrapper.style.border          = "1px solid " + s.fieldBorderColor;
      wrapper.style.backgroundImage = "none";

      var shadow = "none";
      if (s.shadow === "subtle") shadow = "0 1px 3px rgba(0,0,0,0.05), 0 1px 2px rgba(0,0,0,0.05)";
      else if (s.shadow === "medium") shadow = "0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06)";
      else if (s.shadow === "strong") shadow = "0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05)";
      wrapper.style.boxShadow = shadow;

      var applyPadding = function() {
        wrapper.style.padding = (window.innerWidth <= 600 ? s.mobilePadding : s.desktopPadding) + "px";
      };
      applyPadding();
      window.addEventListener("resize", applyPadding);

      // Title & description
      var titleEl = wrapper.querySelector(".pandaforms-title");
      var descEl  = wrapper.querySelector(".pandaforms-desc");
      if (titleEl) { titleEl.style.fontSize = s.titleSize + "px"; titleEl.style.color = s.textColor; titleEl.style.fontFamily = s.fontFamily; }
      if (descEl)  { descEl.style.fontSize  = s.descSize  + "px"; descEl.style.color  = s.textColor; descEl.style.fontFamily  = s.fontFamily; }

      // Fields container gap
      if (fieldsContainer) fieldsContainer.style.gap = s.fieldGap + "px";

    } else {
      // No app styling — just honour the optional width override
      wrapper.style.maxWidth = blockWidth + "px";
    }

    // -------------------------------------------------------------------------
    // Login link display
    // -------------------------------------------------------------------------
    var prefix = form.loginLinkPrefix || "Already have an account?";
    var linkLabel = form.loginLinkLabel || "Sign In";
    var linkPos = form.loginLinkPosition || "After Submit Button";

    if (linkPos === "Before Submit Button") {
      var topCont = wrapper.querySelector(".pandaforms-login-top");
      topCont.style.display = "block";
      wrapper.querySelector(".pandaforms-login-prefix-top").innerText = prefix;
      wrapper.querySelector(".pandaforms-login-link-top").innerText = linkLabel;
      if (activeStyles) topCont.style.color = s.labelColor;
    } else if (linkPos === "After Submit Button") {
      var botCont = wrapper.querySelector(".pandaforms-login-bottom");
      botCont.style.display = "block";
      wrapper.querySelector(".pandaforms-login-prefix-bottom").innerText = prefix;
      wrapper.querySelector(".pandaforms-login-link-bottom").innerText = linkLabel;
      if (activeStyles) botCont.style.color = s.labelColor;
    }

    // -------------------------------------------------------------------------
    // Render form fields
    // -------------------------------------------------------------------------
    var fields = form.fields || [];
    var gapVal = activeStyles ? s.fieldGap : 16;

    fields.forEach(function(field) {
      var fw = document.createElement("div");
      fw.className = "pandaforms-field-wrapper";
      fw.style.display      = field.type === "hidden" ? "none" : "flex";
      fw.style.flexDirection = "column";
      fw.style.boxSizing    = "border-box";

      // Width
      if (field.width === "third")      { fw.style.flex = "1 1 calc(33.33% - " + (gapVal * 2 / 3) + "px)"; fw.style.minWidth = "180px"; }
      else if (field.width === "half")  { fw.style.flex = "1 1 calc(50% - " + (gapVal / 2) + "px)";         fw.style.minWidth = "240px"; }
      else                              { fw.style.flex = "1 1 100%"; }

      // --- Special field types ---
      if (field.type === "step") {
        fw.style.width = "100%"; fw.style.flex = "1 1 100%";
        if (activeStyles) fw.style.borderBottom = "2px dashed " + s.fieldBorderColor;
        fw.style.paddingBottom = "8px"; fw.style.marginTop = "16px"; fw.style.marginBottom = "8px";
        var span = document.createElement("span");
        span.style.fontSize = "12px"; span.style.fontWeight = "700";
        span.style.textTransform = "uppercase"; span.style.letterSpacing = "0.05em";
        if (activeStyles) span.style.color = s.textColor;
        span.innerText = "📍 " + (field.label || "Step Divider");
        fw.appendChild(span);

      } else if (field.type === "title") {
        fw.style.width = "100%"; fw.style.flex = "1 1 100%"; fw.style.marginTop = "12px"; fw.style.marginBottom = "4px";
        var h3 = document.createElement("h3");
        h3.style.margin = "0"; h3.style.fontSize = "18px"; h3.style.fontWeight = "600";
        if (activeStyles) h3.style.color = s.textColor;
        h3.innerText = field.label || "Section Title";
        fw.appendChild(h3);

      } else if (field.type === "description") {
        fw.style.width = "100%"; fw.style.flex = "1 1 100%"; fw.style.marginTop = "4px"; fw.style.marginBottom = "8px";
        var p = document.createElement("p");
        p.style.margin = "0"; p.style.fontSize = "14px"; p.style.opacity = "0.8"; p.style.lineHeight = "1.4";
        if (activeStyles) p.style.color = s.textColor;
        p.innerText = field.label || "";
        fw.appendChild(p);

      } else {
        // Regular field
        if (activeStyles) fw.style.gap = s.labelSpacing + "px";

        var lbl = document.createElement("label");
        lbl.style.fontWeight = "600";
        if (activeStyles) { lbl.style.fontSize = s.labelSize + "px"; lbl.style.color = s.labelColor; lbl.style.fontFamily = s.fontFamily; }
        lbl.innerHTML = field.label + " " + (field.required ? "<span style='color:red'>*</span>" : "");
        fw.appendChild(lbl);

        // Parse choices
        var choices = [];
        try {
          if (field.choices && (field.choices.indexOf("[") === 0 || field.choices.indexOf("{") === 0)) {
            choices = JSON.parse(field.choices);
          } else if (field.choices) {
            choices = field.choices.split(",").map(function(c) { return { label: c.trim(), value: c.trim() }; });
          }
        } catch(e) { choices = (field.choices || "").split(",").map(function(c) { return { label: c.trim(), value: c.trim() }; }); }

        var input = null;

        if (field.type === "textarea") {
          input = document.createElement("textarea");
          input.style.minHeight = "80px";
          input.placeholder = field.placeholder || "";

        } else if (field.type === "select") {
          input = document.createElement("select");
          choices.forEach(function(ch) {
            var opt = document.createElement("option");
            opt.value = ch.value || ch.label; opt.innerText = ch.label;
            input.appendChild(opt);
          });

        } else if (field.type === "radio") {
          input = document.createElement("div");
          input.style.display = "flex"; input.style.flexDirection = "column"; input.style.gap = "5px";
          choices.forEach(function(ch, i) {
            var row = document.createElement("label");
            row.style.display = "flex"; row.style.gap = "8px";
            if (activeStyles) { row.style.fontSize = s.inputSize + "px"; row.style.color = s.textColor; row.style.fontFamily = s.fontFamily; }
            var r = document.createElement("input"); r.type = "radio"; r.name = "field_" + field.id; r.value = ch.value || ch.label;
            if (ch.defaultChecked || (field.required && i === 0)) r.checked = true;
            row.appendChild(r); row.appendChild(document.createTextNode(ch.label)); input.appendChild(row);
          });

        } else if (field.type === "checkbox_list") {
          input = document.createElement("div");
          input.style.display = "flex"; input.style.flexDirection = "column"; input.style.gap = "5px";
          choices.forEach(function(ch) {
            var row = document.createElement("label");
            row.style.display = "flex"; row.style.gap = "8px";
            if (activeStyles) { row.style.fontSize = s.inputSize + "px"; row.style.color = s.textColor; row.style.fontFamily = s.fontFamily; }
            var ck = document.createElement("input"); ck.type = "checkbox"; ck.name = "field_" + field.id; ck.value = ch.value || ch.label;
            if (ch.defaultChecked) ck.checked = true;
            row.appendChild(ck); row.appendChild(document.createTextNode(ch.label)); input.appendChild(row);
          });

        } else if (field.type === "checkbox") {
          input = document.createElement("label");
          input.style.display = "flex"; input.style.gap = "8px";
          if (activeStyles) { input.style.fontSize = s.inputSize + "px"; input.style.color = s.textColor; input.style.fontFamily = s.fontFamily; }
          var ck2 = document.createElement("input"); ck2.type = "checkbox"; ck2.name = "field_" + field.id; ck2.required = field.required;
          input.appendChild(ck2); input.appendChild(document.createTextNode(field.placeholder || "Confirm / Agree"));

        } else {
          input = document.createElement("input"); input.type = field.type;
          if (field.type === "phone" && form.defaultCountryPhoneCode) input.value = form.defaultCountryPhoneCode.split(" ")[0] || "";
          if (field.type !== "hidden") input.placeholder = field.placeholder || "";
        }

        // Apply common styles to single-element inputs
        if (input && field.type !== "radio" && field.type !== "checkbox" && field.type !== "checkbox_list") {
          input.name = "field_" + field.id;
          input.required = field.required;
          input.style.width = "100%";
          input.style.boxSizing = "border-box";
          input.style.outline = "none";
          if (activeStyles) {
            input.style.padding         = s.inputPadding;
            input.style.fontSize        = s.inputSize + "px";
            input.style.backgroundColor = s.fieldBgColor;
            input.style.border          = "1px solid " + s.fieldBorderColor;
            input.style.borderRadius    = s.borderRadius + "px";
            input.style.color           = s.textColor;
            input.style.fontFamily      = s.fontFamily;
          }
        }

        if (input) { input.dataset.label = field.label; input.dataset.type = field.type; fw.appendChild(input); }
      }

      fieldsContainer.appendChild(fw);
    });

    // -------------------------------------------------------------------------
    // Submit button — styled from app design only
    // -------------------------------------------------------------------------
    if (submitBtn && activeStyles) {
      submitBtn.style.padding         = s.btnPadding;
      submitBtn.style.fontSize        = s.btnSize + "px";
      submitBtn.style.fontFamily      = s.fontFamily;
      submitBtn.style.borderRadius    = s.borderRadius + "px";
      submitBtn.style.backgroundColor = s.btnBgColor;
      submitBtn.style.color           = s.btnTextColor;
      var btnShadow = "none";
      if (s.shadow === "subtle") btnShadow = "0 1px 3px rgba(0,0,0,0.05)";
      else if (s.shadow === "medium") btnShadow = "0 4px 6px -1px rgba(0,0,0,0.1)";
      else if (s.shadow === "strong") btnShadow = "0 10px 15px -3px rgba(0,0,0,0.1)";
      submitBtn.style.boxShadow = btnShadow;
    }
    if (submitBtn) {
      submitBtn.style.transition = "background-color 0.2s ease, transform 0.1s ease";
      var origBg = submitBtn.style.backgroundColor;
      submitBtn.addEventListener("mouseenter", function() {
        if (activeStyles && s.btnHoverColor) submitBtn.style.backgroundColor = s.btnHoverColor;
        else submitBtn.style.opacity = "0.85";
      });
      submitBtn.addEventListener("mouseleave", function() {
        if (activeStyles && s.btnHoverColor) submitBtn.style.backgroundColor = origBg;
        else submitBtn.style.opacity = "1";
      });
      submitBtn.addEventListener("mousedown", function() { submitBtn.style.transform = "scale(0.98)"; });
      submitBtn.addEventListener("mouseup",   function() { submitBtn.style.transform = "scale(1)"; });
    }

    // Success banner
    if (successDiv && activeStyles) {
      successDiv.style.color           = s.successColor;
      successDiv.style.backgroundColor = s.successBgColor;
      successDiv.style.borderRadius    = s.borderRadius + "px";
      successDiv.style.border          = "1px solid " + s.successColor;
    }

    loadingDiv.style.display = "none";
    contentDiv.style.display = "block";
  })
  .catch(function(err) {
    console.error("PandaForms load error:", err);
    loadingDiv.innerHTML =
      "<div style='padding:16px;border:1px solid #fca5a5;border-radius:6px;background:#fef2f2;color:#b42318;font-family:sans-serif;font-size:14px;'>" +
        "<strong style='display:block;margin-bottom:6px;'>⚠️ PandaForms — Could not load form</strong>" +
        "Please verify:<br>" +
        "1. The store has at least one active PandaForms form.<br>" +
        "2. The PandaForms app is installed and running on this store." +
      "</div>";
  });

  // ---------------------------------------------------------------------------
  // Form submission
  // ---------------------------------------------------------------------------
  formEl.addEventListener("submit", function(e) {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.style.opacity = "0.5";
    submitBtn.innerText = "Submitting...";

    var fieldsData = {};
    formEl.querySelectorAll("[name^='field_']").forEach(function(el) {
      var label = el.dataset.label || el.name;
      if (el.type === "checkbox") { fieldsData[label] = el.checked ? "Yes" : "No"; }
      else if (el.type === "radio") { if (el.checked) fieldsData[label] = el.value; }
      else { fieldsData[label] = el.value; }
    });
    formEl.querySelectorAll("div[name^='field_']").forEach(function(div) {
      var checked = div.querySelector("input:checked");
      if (checked) fieldsData[div.dataset.label] = checked.value;
    });

    function postSubmission(url) {
      return fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json", "ngrok-skip-browser-warning": "true", "bypass-tunnel-reminder": "true" },
        body: JSON.stringify({ formId: formId, fields: fieldsData })
      });
    }

    postSubmission(submitEndpoint)
    .then(function(res) {
      if (!res.ok) throw new Error("App proxy submit failed: " + res.status);
      return res.json();
    })
    .catch(function() {
      return postSubmission(directSubmitEndpoint).then(function(res) {
        if (!res.ok) throw new Error("Direct submit failed: " + res.status);
        return res.json();
      });
    })
    .then(function(res) {
      if (res.success) {
        if (redirectUrl) { window.location.href = redirectUrl; }
        else { contentDiv.style.display = "none"; successDiv.style.display = "block"; }
      } else {
        alert("Submission error: " + (res.error || "Unknown error"));
        resetBtn();
      }
    })
    .catch(function() { alert("Failed to submit. Please try again."); resetBtn(); });

    function resetBtn() { submitBtn.disabled = false; submitBtn.style.opacity = "1"; submitBtn.innerText = "Submit"; }
  });

})();
</script>

{% schema %}
{
  "name": "PandaForms Widget",
  "target": "body",
  "settings": [
    { "type": "header", "content": "Styling" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" },
        { "value": "scheme-5", "label": "Scheme 5" }
      ]
    },
    { "type": "checkbox", "id": "use_app_styling", "label": "Use PandaForms app styling", "info": "When enabled, all colours and layout come from Widget Styling Settings inside PandaForms. Disable to use your theme defaults.", "default": true },
    { "type": "checkbox", "id": "adopt_theme_styling", "label": "Adopt selected theme colour scheme", "info": "When enabled, this widget uses the selected Shopify colour scheme for text, fields, and buttons while keeping PandaForms spacing and layout.", "default": false },
    {
      "type": "select",
      "id": "widget_font_source",
      "label": "Font",
      "default": "app",
      "options": [
        { "value": "app", "label": "Use PandaForms app font" },
        { "value": "theme_body", "label": "Use theme body font" },
        { "value": "theme_heading", "label": "Use theme heading font" }
      ]
    },
    { "type": "header", "content": "Width (Optional Override)" },
    { "type": "checkbox", "id": "override_width", "label": "Override form width", "default": false },
    { "type": "range", "id": "form_width", "label": "Form Width", "min": 320, "max": 1200, "step": 10, "default": 650, "unit": "px" },
    { "type": "header", "content": "Section Spacing" },
    {
      "type": "select",
      "id": "card_spacing",
      "label": "Top & Bottom Spacing",
      "default": "medium",
      "options": [
        { "value": "none",   "label": "None" },
        { "value": "small",  "label": "Small (12px)" },
        { "value": "medium", "label": "Medium (24px)" },
        { "value": "large",  "label": "Large (48px)" },
        { "value": "huge",   "label": "Extra Large (80px)" }
      ]
    }
  ]
}
{% endschema %}
